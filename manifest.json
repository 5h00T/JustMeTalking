{
    "manifest_version": 3,
    "name": "Just Me Talking",
    "version": "1.0.0",
    "minimum_chrome_version": "123",
    "description": "YouTube Liveのチャット欄を、自分のコメントだけに切り替えます。",
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Just Me Talking",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/live_chat*"
            ],
            "all_frames": true,
            "world": "MAIN",
            "run_at": "document_start",
            "js": [
                "page-bridge.js"
            ]
        },
        {
            "matches": [
                "https://www.youtube.com/live_chat*"
            ],
            "all_frames": true,
            "run_at": "document_idle",
            "js": [
                "shared.js",
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ]
}